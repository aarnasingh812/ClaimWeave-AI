---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	acquire(acquire)
	extract_policy(extract_policy)
	verify(verify)
	classify(classify)
	requirements(requirements)
	extract_documents(extract_documents)
	check_documents(check_documents)
	draft(draft)
	validate(validate)
	review(review)
	finalize(finalize)
	__end__([<p>__end__</p>]):::last
	__start__ --> acquire;
	acquire -.-> classify;
	acquire -.-> extract_policy;
	check_documents --> draft;
	classify --> requirements;
	draft --> validate;
	extract_documents --> check_documents;
	extract_policy --> verify;
	requirements --> extract_documents;
	review -. &nbsp;end&nbsp; .-> __end__;
	review -.-> finalize;
	validate -. &nbsp;end&nbsp; .-> __end__;
	validate -.-> review;
	verify -. &nbsp;end&nbsp; .-> __end__;
	verify -.-> classify;
	finalize --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
